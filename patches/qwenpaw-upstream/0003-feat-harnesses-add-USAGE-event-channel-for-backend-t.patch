 src/qwenpaw/harnesses/runtime.py         |  78 +++++++++
 src/qwenpaw/token_usage/model_wrapper.py |  92 +++++++----
 tests/unit/harnesses/test_runtime.py     | 191 +++++++++++++++++++++++
 4 files changed, 349 insertions(+), 31 deletions(-)

